syntax = "v1"

info (
	title:   "智能体服务"
	desc:    "智能体服务"
	author:  "Bluore"
	email:   "a@bluore.top"
	version: "v1"
)

import (
	"agent/agent.api"
)

@server (
	prefix: /api/agent/v1
	jwt:    JwtAuth
)
service agent {
	@doc "create session"
	@handler createSession
	post /session/create (CreateSessionReq) returns (CreateSessionResp)

	@doc "resume session"
	@handler resumeSession
	post /session/resume (ResumeSessionReq) returns (ResumeSessionResp)

	@doc "human feedback"
	@handler humanFeedback
	post /session/feedback (HumanFeedbackReq) returns (HumanFeedbackResp)

	@doc "list session"
	@handler listSession
	get /session/list (ListSessionReq) returns (ListSessionResp)
}

// SSE 长连接需要关闭 go-zero 默认的请求/网络写超时, 否则连接会在数秒后被截断
@server (
	prefix:  /api/agent/v1
	jwt:     JwtAuth
	timeout: 0
)
service agent {
	@doc "get session (SSE)"
	@handler getSession
	get /session/stream/:id (GetSessionReq) returns (GetSessionResp)
}


syntax = "v1"

info (
	title:   "文档实例"
	desc:    "文档实例"
	author:  "Bluore"
	email:   "a@bluore.top"
	version: "v1"
)

import (
	"document/document.api"
)

@server (
	prefix: /api/doc/v1
	jwt:    JwtAuth
)
service document {
	@doc "create document"
	@handler createDocument
	post /document (CreateDocumentReq) returns (CreateDocumentResp)

	@doc "delete document"
	@handler deleteDocument
	delete /document (DeleteDocumentReq) returns (DeleteDocumentResp)

	@doc "get document info"
	@handler infoDocument
	get /document/info (GetDocumentInfoReq) returns (GetDocumentInfoResp)

	@doc "get document content"
	@handler getDocumentContent
	get /document/content (GetDocumentContentReq) returns (GetDocumentContentResp)

	@doc "list document"
	@handler listDocument
	get /document/list (GetDocumentListReq) returns (GetDocumentListResp)

	@doc "get grant link"
	@handler getGrantLink
	get /document/grant (GetGrantLinkReq) returns (GetGrantLinkResp)

	@doc "publish document snapshot"
	@handler publishDocumentSnapshot
	post /document/snapshot (PublishDocumentSnapshotReq) returns (PublishDocumentSnapshotResp)
}

@server (
	prefix: /api/doc/v1
)
service document {
	@doc "get snapshot document content"
	@handler getSnapshotDocument
	get /document/snapshot/content (GetSnapshotDocumentReq) returns (GetSnapshotDocumentResp)
}


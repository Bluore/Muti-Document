syntax = "v1"

info (
    title: "文档实例"
    desc: "文档实例"
    author: "Bluore"
    email: "a@bluore.top"
    version: "v1"
)

type Document {
    Id string `json:"id"`
    OwnerId string `json:"owner_id"`
    Summary string `json:"summary"`
    
    CreateAt int64 `json:"create_at"`
    UpdateAt int64 `json:"update_at"`
}

type (
    CreateDocumentReq {
    }
    CreateDocumentResp {
        DocumentId string `json:"document_id"`
    }
)

type (
    DeleteDocumentReq {
        DocumentId string `json:"document_id"`
    }
    DeleteDocumentResp {
    }
)

type (
    GetDocumentInfoReq {
        DocumentId string `form:"document_id"`
    }
    GetDocumentInfoResp {
        DocumentInfo Document `json:"document_info"`
    }
)

type (
    GetDocumentContentReq {
        DocumentId string `form:"document_id"`
    }
    GetDocumentContentResp {
        Content string `json:"content"`
        Summary string `json:"summary"`
        Version int64  `json:"version"`
    }
)

type (
    GetDocumentListReq {
        Page int `form:"page"`
        Size int `form:"size"`
    }
    GetDocumentListResp {
        DocumentInfo []Document `json:"documents_info"`
        DocumentLen int `json:"documents_len"`
    }
)

type (
    GetGrantLinkReq {
        DocumentId string `form:"document_id"`
    }
    GetGrantLinkResp {
        Link string `json:"link"`
    }
)

type (
    PublishDocumentSnapshotReq {
        DocumentId string `json:"document_id"`
    }
    PublishDocumentSnapshotResp {
        SnapshotId string `json:"snapshot_id"`
        ShortLink  string `json:"short_link"`
    }
)

type (
    GetSnapshotDocumentReq {
        SnapshotId string `form:"snapshot_id"`
    }
    GetSnapshotDocumentResp {
        Id       string `json:"id"`
        OwnerId  string `json:"owner_id"`
        Summary  string `json:"summary"`
        Content  string `json:"content"`
        Version  int64  `json:"version"`
        CreateAt int64  `json:"create_at"`
        UpdateAt int64  `json:"update_at"`
    }
)
